# systemd unit for the MasterBus -> Signal K bridge.
#
# Install:
#   sudo cp target/<triple>/release/masterbus-signalk /usr/local/bin/
#   sudo cp masterbus-signalk.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now masterbus-signalk
#
# Everything this host is configured with lives in ONE directory,
# /etc/default/masterbus/ (created by systemd on first start, see
# ConfigurationDirectory= below):
#
#   config.ini   transport, master role, schema cache directory, and the
#                `listen` address for this service. Auto-created on first run
#                with detected defaults; review and edit — see
#                `masterbus::FileConfig` for the format.
#   mapping.json which MasterBus field publishes to which Signal K path,
#                keyed on device serial and field id. Seeded from built-in
#                heuristics on the first run that finds no file; curate it
#                while the service is stopped, then restart.
#
# Upgrading from a release that used /etc/default/masterbus-signalk/: copy any
# LISTEN= you set in that directory's `config` file into config.ini's `listen`
# key, then delete the directory. Its mapping.ini is not carried over — the
# format changed from group toggles to explicit per-field Signal K paths, and
# the first run writes a fresh mapping.json seeded from the same heuristics the
# old build used.
#
# Then add a Signal K data connection of type "Signal K" over TCP pointing at
# this host on the listen port (default 3009).

[Unit]
Description=Mastervolt MasterBus to Signal K bridge
Documentation=https://github.com/keesverruijt/masterbus
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
SyslogIdentifier=masterbus-signalk

# The listen address and the mapping file both come from
# /etc/default/masterbus/, so this unit needs no environment of its own.
ExecStart=/usr/local/bin/masterbus-signalk

Restart=on-failure
RestartSec=5

# Persistent schema cache in /var/lib/masterbus (created and owned automatically;
# the path is read from /etc/default/masterbus/config.ini's `cache_dir` key,
# which defaults to /var/lib/masterbus on first run).
StateDirectory=masterbus

# Create /etc/default/masterbus before the service starts. ReadWritePaths=
# below refuses to start the unit (exit code 226/NAMESPACE) when a listed path
# does not exist, and on a fresh install it does not: config.ini is only
# written by the first run. Paths are relative to /etc.
ConfigurationDirectory=default/masterbus

# Hardening. The service writes mapping.json in /etc on first run, which a DynamicUser
# sandbox can't own, so it runs as root but is tightly confined: the only
# writable paths are the config dir and the state dir, the only capability is
# CAP_NET_RAW (for SocketCAN), and the syscall/address-family surface is limited.
CapabilityBoundingSet=CAP_NET_RAW
AmbientCapabilities=CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/default/masterbus
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_CAN
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
